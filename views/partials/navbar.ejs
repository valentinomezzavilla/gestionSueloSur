<header class="px-4 py-3 d-flex align-items-center justify-content-between" style="background:#fff;border-bottom:1px solid #eee">
  <h6 class="mb-0 fw-bold" style="color:#2a2a2e">
    <%= typeof titulo !== 'undefined' ? titulo : 'Sistema de Gestión' %>
  </h6>
  <div class="d-flex align-items-center gap-3">
    <small style="color:#888"><%= new Date().toLocaleDateString('es-AR', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) %></small>
    <span class="badge" style="background:#ff6b35"><%= user?.nombre %></span>
  </div>
</header>
